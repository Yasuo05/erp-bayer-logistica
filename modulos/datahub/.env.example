APP_NAME="Bayer-Pucchun Data Hub"
APP_ENV=local
APP_DEBUG=false
# Debe terminar en /modulos/datahub/public: así coinciden las rutas con los enlaces del menú del ERP
APP_URL=http://localhost:8080/modulos/datahub/public
APP_TIMEZONE=America/Lima
# Misma base unificada que el ERP
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=bayer_pucchun_erp_v2
DB_USER=root
DB_PASS=cambiar_clave
# Debe ser la misma cookie de sesión del ERP (PHPSESSID) para entrar sin un segundo login
SESSION_NAME=PHPSESSID
API_ENABLED=false
API_TOKEN=CAMBIAR_TOKEN_LARGO_Y_ALEATORIO
