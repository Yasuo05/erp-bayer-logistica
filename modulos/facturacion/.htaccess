# Todo se envía a public/: así app/, config/, database/, vendor/ y .env nunca quedan expuestos.
# (En el VPS lo ideal es que la raíz del sitio apunte directo a public/)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^$ public/ [L]
    RewriteRule (.*) public/$1 [L]
</IfModule>

# Sin mod_rewrite no hay forma segura de servir el proyecto: se bloquea
<IfModule !mod_rewrite.c>
    Require all denied
</IfModule>
