# Copia este archivo como .env y ajusta los valores de tu PC. El .env NO se sube a Git.
APP_ENV=local
APP_DEBUG=true

# Base de datos central del ERP (nombre provisional hasta que el Grupo 4 defina el oficial)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bayer_pucchun_erp_v2
DB_USERNAME=root
DB_PASSWORD=

# Tasa solo para cálculos de demostración; confirmar las reglas del proyecto antes de uso real.
APP_IGV_RATE=0.18

# Firma digital del XML. Para pruebas: php bin/generar_certificado_demo.php (SUNAT no acepta ese certificado).
# En producción: ruta al .pfx de la empresa y su contraseña.
FIRMA_CERTIFICADO=storage/certificados/certificado-demo.pfx
FIRMA_CLAVE=demo1234

# Opcional: middleware/API externo de envío. Si se deja vacío se usa GatewayDemo (sin envío real).
ENVIO_GATEWAY_URL=
ENVIO_GATEWAY_TOKEN=
ENVIO_GATEWAY_TIMEOUT=20
